{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(flutter pub publish*)",
      "Bash(dart pub publish*)",
      "Bash(fastlane deliver*)",
      "Bash(fastlane supply*)",
      "Bash(bundle exec fastlane*)",
      "Bash(firebase appdistribution:distribute*)",
      "Bash(firebase firestore:delete*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(supabase db reset*)",
      "Bash(keytool -genkey*)",
      "Bash(rm -rf /*)",
      "Read(./android/key.properties)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./.env*)",
      "Read(./ios/Runner/GoogleService-Info.plist)",
      "Read(./android/app/google-services.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-use.sh"
          }
        ]
      }
    ]
  }
}
